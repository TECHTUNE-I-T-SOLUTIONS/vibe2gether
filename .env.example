# Vibe2gether environment example
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-generate-one-with-openssl-rand-base64-32

# Supabase (fill these with your project values)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# Email (SMTP) settings — replace EMAIL_PASS with your app-specific password
EMAIL_HOST=smtp.vibe2gether.com
EMAIL_PORT=587
EMAIL_USER=events@vibe2gether.com
EMAIL_PASS=replace-with-your-app-password
EMAIL_FROM="Vibe2gether <events@vibe2gether.com>"
EMAIL_SECURE=false
EMAIL_TLS_REJECT_UNAUTHORIZED=false

# Examples (uncomment & use if you host with Gmail)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_SECURE=true# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-generate-one-with-openssl-rand-base64-32

# Email Configuration
EMAIL_HOST=smtp.vibe2gether.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=events@vibe2gether.com
EMAIL_PASS=your_app_password

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Database (if using direct connection)
DATABASE_URL=postgresql://user:password@localhost:5432/vibe2gether
